# ---------- Required ----------
NODE_ENV=development
PORT=5000
MONGODB_URI=
# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
CLIENT_ORIGIN=http://localhost:5173

# ---------- Admin account (used only by `npm run seed`) ----------
ADMIN_NAME=Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---------- ImageKit (needed for video uploads) ----------
# Private key from imagekit.io -> Developer options -> API keys
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_FOLDER=/cs-reels
MAX_VIDEO_MB=50

# ---------- AI (needed for Explain / Quiz / Chat) ----------
AI_PROVIDER=gemini
GEMINI_API_KEY=
# Check aistudio.google.com for a model that is currently free for your project
GEMINI_MODEL=gemini-2.5-flash-lite
